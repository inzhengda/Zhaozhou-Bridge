page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #d9cfba;
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

.stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.gl {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 抬头 ---------- */

/* top 由 index.js 的 measureTop() 量出来，走行内 style。
   写成 calc(N rpx + env(safe-area-inset-top)) 在模拟器和安卓上
   env() 恒为 0，这一块会正好顶在状态栏和右上角胶囊按钮下面 */
.title {
  position: absolute;
  left: 34rpx;
  pointer-events: none;
}

.title-main {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: #2b2723;
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.6);
}

.title-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(43, 39, 35, 0.62);
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.55);
}

/* 抬头这一行已经整体让到胶囊按钮下面了，右边不用再空出 210rpx */
.fps {
  position: absolute;
  right: 34rpx;
  font-size: 19rpx;
  color: rgba(43, 39, 35, 0.42);
  pointer-events: none;
}

/* ---------- 数据出处 ---------- */

/* 触发器压在抬头右下，纵向落在抬头与读数卡之间 */
.src-btn {
  position: absolute;
  right: 34rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  border-radius: 999rpx;
  color: #8e3b26;
  background: rgba(252, 248, 240, 0.84);
  border: 1rpx solid rgba(158, 132, 96, 0.42);
}

.src-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 26, 22, 0.42);
}

.src {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  border-radius: 18rpx;
  background: #fcf8f0;
  box-shadow: 0 12rpx 44rpx rgba(40, 30, 18, 0.3);
  overflow: hidden;
}

.src-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(158, 132, 96, 0.26);
}

.src-title {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #2b2723;
}

.src-close {
  font-size: 22rpx;
  color: #8e3b26;
  padding: 4rpx 12rpx;
}

/* 页签的间距用左右对称的 margin，不用 :last-child。
   WXSS 只认 .class / #id / 元素 / ::after / ::before 这一小撮选择器，
   伪类拿掉末项边距那一套在这里写不出来；对称留白多缩进 4rpx，看不出 */
.src-tabs {
  display: flex;
  padding: 12rpx 24rpx 0;
}

.src-tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  margin: 0 4rpx;
  font-size: 23rpx;
  letter-spacing: 4rpx;
  border-radius: 8rpx;
  color: rgba(43, 39, 35, 0.6);
  background: rgba(158, 132, 96, 0.14);
}

.src-tab.on {
  color: #fdf6ec;
  background: #8e3b26;
}

/* min-height: 0 不能省。flex 项默认 min-height: auto，内容比容器高时它宁可
   撑破也不收缩；外层 .src 又是 overflow: hidden，撑出去的那截就被裁掉，
   而且 scroll-view 拿不到确定的可用高度，滚都滚不动——整块下半个面板直接消失 */
.src-body {
  flex: 1;
  min-height: 0;
  padding: 16rpx 28rpx 28rpx;
}

.src-group {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #8e3b26;
}

/* 条目用两栏对齐：左边名目、右边数值。名目定宽 150rpx，
   最长的「矢跨比」「并列拱券」都放得下，不必换行 */
.src-row {
  display: flex;
  padding: 7rpx 0;
  border-bottom: 1rpx solid rgba(158, 132, 96, 0.14);
}

.src-k {
  width: 158rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: rgba(43, 39, 35, 0.5);
}

.src-v {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.82);
}

.src-src {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.38);
}

.src-note {
  margin-top: 26rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(158, 132, 96, 0.13);
  font-size: 19rpx;
  line-height: 1.6;
  color: rgba(43, 39, 35, 0.6);
}

/* ---------- 营造阶段卡 ---------- */

.phase {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(252, 248, 240, 0.9);
  border: 1rpx solid rgba(158, 132, 96, 0.34);
  box-shadow: 0 6rpx 24rpx rgba(60, 46, 28, 0.13);
}

.phase-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #8e3b26;
  letter-spacing: 2rpx;
}

.phase-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: rgba(43, 39, 35, 0.68);
}

.bar {
  margin-top: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(158, 132, 96, 0.22);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #c4563a, #d99a52);
  transition: width 0.12s linear;
}

.phase-foot {
  margin-top: 9rpx;
  display: flex;
  justify-content: space-between;
  font-size: 19rpx;
  color: rgba(43, 39, 35, 0.5);
}

/* ---------- 泄洪读数 ---------- */

.hud {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(22, 32, 44, 0.72);
  backdrop-filter: blur(6px);
  box-shadow: 0 6rpx 24rpx rgba(14, 22, 32, 0.26);
}

.hud-row {
  display: flex;
}

.cell {
  flex: 1;
  text-align: center;
}

.cell-v {
  font-size: 32rpx;
  font-weight: 600;
  color: #eef4f8;
  font-variant-numeric: tabular-nums;
}

.cell-k {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(214, 230, 240, 0.6);
}

/* ---------- 敞肩对比 ---------- */

.cmp {
  position: absolute;
  left: 34rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(252, 248, 240, 0.9);
  border-left: 5rpx solid #c4563a;
  box-shadow: 0 6rpx 22rpx rgba(60, 46, 28, 0.13);
}

/* 两栏并排。左栏「此刻的水力对比」、右栏「静态的省料账」，
   原来竖排成八行，高度顶到桥面上去了 */
.cmp-row {
  display: flex;
}

.cmp-col {
  flex: 1;
  padding-right: 14rpx;
}

.cmp-title {
  font-size: 19rpx;
  font-weight: 600;
  color: #8e3b26;
  margin-bottom: 6rpx;
}

/* 横跨两栏的那一行（此刻过水的是哪几孔小拱），与上面两栏之间留一档间距 */
.cmp-wide {
  margin-top: 8rpx;
}

.cmp-line {
  font-size: 19rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.7);
}

.hl {
  color: #b8452b;
  font-weight: 600;
}

/* ---------- 底部控制台 ---------- */

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: rgba(252, 248, 240, 0.94);
  box-shadow: 0 -6rpx 30rpx rgba(60, 46, 28, 0.15);
}

.tabs {
  display: flex;
  gap: 10rpx;
  padding: 5rpx;
  border-radius: 12rpx;
  background: rgba(158, 132, 96, 0.16);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  letter-spacing: 6rpx;
  color: rgba(43, 39, 35, 0.6);
  border-radius: 9rpx;
}

.tab.on {
  background: #fdfaf4;
  color: #8e3b26;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(60, 46, 28, 0.12);
}

.ctrl {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.grow { flex: 1; }

.lab {
  font-size: 22rpx;
  color: rgba(43, 39, 35, 0.62);
  min-width: 60rpx;
}

.val {
  font-size: 21rpx;
  color: #3a6f9e;
  min-width: 140rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.btn {
  padding: 12rpx 30rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  color: #fdf6ec;
  background: #c4563a;
}

.btn.ghost {
  color: #8e3b26;
  background: rgba(196, 86, 58, 0.13);
}

.views {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.chip {
  padding: 9rpx 22rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  color: rgba(43, 39, 35, 0.66);
  background: rgba(158, 132, 96, 0.15);
}

.chip.on {
  color: #fdf6ec;
  background: #8e3b26;
}

.hint {
  margin: 12rpx 4rpx 0;
  font-size: 19rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.46);
}
