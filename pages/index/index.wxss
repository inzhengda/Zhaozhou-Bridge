page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #d9cfba;
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

.stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.gl {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 抬头 ---------- */

/* top 由 index.js 的 measureTop() 量出来，走行内 style。
   写成 calc(N rpx + env(safe-area-inset-top)) 在模拟器和安卓上
   env() 恒为 0，这一块会正好顶在状态栏和右上角胶囊按钮下面 */
.title {
  position: absolute;
  left: 34rpx;
  pointer-events: none;
}

.title-main {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: #2b2723;
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.6);
}

.title-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(43, 39, 35, 0.62);
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.55);
}

/* ---------- 右上角的两枚浮层开关 ---------- */

/* 剖面图 与 数据出处 并排，落位由外层统一给（top 见 index.js 的 topBtn）。
   两枚都是"随时可查"的参考浮层，不属于任何一个模式，所以放在这里
   而不是底下那排模式内的 chip 里 */
.topbtns {
  position: absolute;
  right: 34rpx;
  display: flex;
}

.src-btn {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  border-radius: 999rpx;
  color: #8e3b26;
  background: rgba(252, 248, 240, 0.84);
  border: 1rpx solid rgba(158, 132, 96, 0.42);
}

.src-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 26, 22, 0.42);
}

.src {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  border-radius: 18rpx;
  background: #fcf8f0;
  box-shadow: 0 12rpx 44rpx rgba(40, 30, 18, 0.3);
  overflow: hidden;
}

.src-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(158, 132, 96, 0.26);
}

.src-title {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #2b2723;
}

.src-close {
  font-size: 22rpx;
  color: #8e3b26;
  padding: 4rpx 12rpx;
}

/* 页签的间距用左右对称的 margin，不用 :last-child。
   WXSS 只认 .class / #id / 元素 / ::after / ::before 这一小撮选择器，
   伪类拿掉末项边距那一套在这里写不出来；对称留白多缩进 4rpx，看不出 */
.src-tabs {
  display: flex;
  padding: 12rpx 24rpx 0;
}

.src-tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  margin: 0 4rpx;
  font-size: 23rpx;
  letter-spacing: 4rpx;
  border-radius: 8rpx;
  color: rgba(43, 39, 35, 0.6);
  background: rgba(158, 132, 96, 0.14);
}

.src-tab.on {
  color: #fdf6ec;
  background: #8e3b26;
}

/* min-height: 0 不能省。flex 项默认 min-height: auto，内容比容器高时它宁可
   撑破也不收缩；外层 .src 又是 overflow: hidden，撑出去的那截就被裁掉，
   而且 scroll-view 拿不到确定的可用高度，滚都滚不动——整块下半个面板直接消失 */
.src-body {
  flex: 1;
  min-height: 0;
  /* scroll-view 不吃父级的 overflow:hidden（iOS 原生层浮在 WebView 之上），
     没有这行，左右 padding 会把盒子撑得比面板宽 56rpx，右缘顶出屏幕，
     右栏文字和注释块整列被切——数据出处面板文字截断的根因就是它 */
  box-sizing: border-box;
  padding: 16rpx 28rpx 28rpx;
}

.src-group {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #8e3b26;
}

/* 条目用两栏对齐：左边名目、右边数值。名目定宽 150rpx，
   最长的「矢跨比」「并列拱券」都放得下，不必换行 */
.src-row {
  display: flex;
  padding: 7rpx 0;
  border-bottom: 1rpx solid rgba(158, 132, 96, 0.14);
}

.src-k {
  width: 158rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: rgba(43, 39, 35, 0.5);
}

.src-v {
  flex: 1;
  /* flex 项默认 min-width:auto，长文本（书名号、数字串）会把右栏撑出容器 */
  min-width: 0;
  word-break: break-word;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.82);
}

.src-src {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.38);
}

/* ---------- 年表 ---------- */

/* 年份窄栏在左、事件在右。年份这一栏定宽，各行的事件就都从同一条线起，
   讲的时候眼睛不用横着找 */
.an-row {
  display: flex;
  padding: 12rpx 0 14rpx;
  border-bottom: 1rpx solid rgba(158, 132, 96, 0.14);
}

.an-y {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #8e3b26;
}

.an-body {
  flex: 1;
}

.an-t {
  display: block;
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(43, 39, 35, 0.82);
}

.an-s {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.38);
}

 /* ---------- 营造阶段卡 ---------- */

.phase {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(252, 248, 240, 0.9);
  border: 1rpx solid rgba(158, 132, 96, 0.34);
  box-shadow: 0 6rpx 24rpx rgba(60, 46, 28, 0.13);
}

.phase-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #8e3b26;
  letter-spacing: 2rpx;
}

.phase-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: rgba(43, 39, 35, 0.68);
}

.bar {
  margin-top: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(158, 132, 96, 0.22);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #c4563a, #d99a52);
  transition: width 0.12s linear;
}

.phase-foot {
  margin-top: 9rpx;
  display: flex;
  justify-content: space-between;
  font-size: 19rpx;
  color: rgba(43, 39, 35, 0.5);
}

/* ---------- 泄洪读数 ---------- */

.hud {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(22, 32, 44, 0.72);
  backdrop-filter: blur(6px);
  box-shadow: 0 6rpx 24rpx rgba(14, 22, 32, 0.26);
}

.hud-row {
  display: flex;
}

.cell {
  flex: 1;
  text-align: center;
}

.cell-v {
  font-size: 32rpx;
  font-weight: 600;
  color: #eef4f8;
  font-variant-numeric: tabular-nums;
}

.cell-k {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(214, 230, 240, 0.6);
}

/* ---------- 敞肩对比 ---------- */

/* 这张卡的底边离桥面最近：抬头量到胶囊下沿、读数卡再往下排，
   390 px 宽的机器上算下来正好压在桥面栏板顶上。行高收到 1.42、
   上下留白收到 12rpx，整卡矮掉约 10 px，才让得开 */
.cmp {
  position: absolute;
  left: 34rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(252, 248, 240, 0.9);
  border-left: 5rpx solid #c4563a;
  box-shadow: 0 6rpx 22rpx rgba(60, 46, 28, 0.13);
}

/* 两栏并排。左栏「此刻的水力对比」、右栏「静态的省料账」，
   原来竖排成八行，高度顶到桥面上去了 */
.cmp-row {
  display: flex;
}

.cmp-col {
  flex: 1;
  padding-right: 14rpx;
}

.cmp-title {
  font-size: 19rpx;
  font-weight: 600;
  color: #8e3b26;
  margin-bottom: 6rpx;
}

/* 横跨两栏的那一行（此刻过水的是哪几孔小拱），与上面两栏之间留一档间距 */
.cmp-wide {
  margin-top: 8rpx;
}

.cmp-line {
  font-size: 19rpx;
  line-height: 1.42;
  color: rgba(43, 39, 35, 0.7);
}

.hl {
  color: #b8452b;
  font-weight: 600;
}

/* ---------- 底部控制台 ---------- */

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: rgba(252, 248, 240, 0.94);
  box-shadow: 0 -6rpx 30rpx rgba(60, 46, 28, 0.15);
}

.tabs {
  display: flex;
  gap: 10rpx;
  padding: 5rpx;
  border-radius: 12rpx;
  background: rgba(158, 132, 96, 0.16);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  letter-spacing: 6rpx;
  color: rgba(43, 39, 35, 0.6);
  border-radius: 9rpx;
}

.tab.on {
  background: #fdfaf4;
  color: #8e3b26;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(60, 46, 28, 0.12);
}

.ctrl {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.grow { flex: 1; }

.lab {
  font-size: 22rpx;
  color: rgba(43, 39, 35, 0.62);
  min-width: 60rpx;
}

.val {
  font-size: 21rpx;
  color: #3a6f9e;
  min-width: 140rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 水量尺：滑块下面那条三段尺。
   段宽由行内 flex 给（各段按自己的流量区间等比），交界处于是天然落在
   两个临界流量上——既不用算百分比，也不用去迁就滑块轨道左右那点留白。
   三段全亮时靠每条左边的细白线留着界，不至于糊成一条蓝 */
.bands {
  display: flex;
  margin-top: 8rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.band {
  padding: 7rpx 2rpx;
  text-align: center;
  white-space: nowrap;
  font-size: 18rpx;
  color: rgba(43, 39, 35, 0.52);
  background: rgba(158, 132, 96, 0.16);
  border-left: 1rpx solid rgba(252, 248, 240, 0.85);
}

.band.on {
  color: #fdf6ec;
  background: #3a6f9e;
}

.btn {
  padding: 12rpx 30rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  color: #fdf6ec;
  background: #c4563a;
}

.btn.ghost {
  color: #8e3b26;
  background: rgba(196, 86, 58, 0.13);
}

.views {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.chip {
  padding: 9rpx 22rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  color: rgba(43, 39, 35, 0.66);
  background: rgba(158, 132, 96, 0.15);
}

.chip.on {
  color: #fdf6ec;
  background: #8e3b26;
}

.hint {
  margin: 12rpx 4rpx 0;
  font-size: 19rpx;
  line-height: 1.5;
  color: rgba(43, 39, 35, 0.46);
}

/* ---------- 部位聚焦卡 ---------- */

/* 点中部位后弹出的讲解卡，与阶段卡/读数卡同位互斥（WXML 里 !focus 控制）。
   左侧一道朱红竖线标记"这是选中态"，和 .cmp 的强调写法一致 */
.focus {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(252, 248, 240, 0.94);
  border: 1rpx solid rgba(158, 132, 96, 0.34);
  border-left: 5rpx solid #c4563a;
  box-shadow: 0 6rpx 24rpx rgba(60, 46, 28, 0.13);
}

.focus-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.focus-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #8e3b26;
  letter-spacing: 2rpx;
}

.focus-close {
  font-size: 22rpx;
  color: #8e3b26;
  padding: 4rpx 12rpx;
}

.focus-l1 {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: rgba(43, 39, 35, 0.8);
}

.focus-l2 {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: rgba(43, 39, 35, 0.6);
}

/* ---------- 说课导览 ---------- */

/* 盖在底部控制台之上的讲稿卡。九步里每步的机位、模式、开关都由
   applyTourStep 摆好，录屏时只需点"下一步"。上边一道朱红压边，
   和普通控制台一眼区分开 */
.tour {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  border-top: 5rpx solid #c4563a;
  background: rgba(252, 248, 240, 0.97);
  box-shadow: 0 -6rpx 30rpx rgba(60, 46, 28, 0.18);
}

.tour-head {
  display: flex;
  align-items: center;
}

.tour-step {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
  color: #fdf6ec;
  background: #c4563a;
}

.tour-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #8e3b26;
}

.tour-exit {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(43, 39, 35, 0.55);
  padding: 6rpx 12rpx;
}

.tour-text {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: rgba(43, 39, 35, 0.78);
}

.tour-btns {
  display: flex;
  margin-top: 16rpx;
}

.tour-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  border-radius: 10rpx;
  color: #8e3b26;
  background: rgba(196, 86, 58, 0.13);
}

/* WXSS 拿不到 :last-child，右距只写在"上一步"这一枚上 */
.tour-btn.prev {
  margin-right: 14rpx;
}

.tour-btn.off {
  opacity: 0.4;
}

.tour-btn.main {
  color: #fdf6ec;
  background: #c4563a;
}

/* ==================== 按压反馈与触控目标 ====================
   view 原生 hover-class：按下补上 .pressed，0.12 s 过渡让按下和
   回弹都看得见。触控高度同步抬到 28–40 px——教学场景老人小孩都在用，
   误触比按钮走形更伤体验 */

.src-btn, .tab, .btn, .chip, .band, .tour-btn, .tour-exit, .focus-close, .src-close, .src-tab {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.pressed {
  transform: scale(0.95);
  opacity: 0.82;
}

.src-btn { min-height: 56rpx; display: flex; align-items: center; }
.tab { min-height: 72rpx; display: flex; align-items: center; justify-content: center; }
.btn { min-height: 72rpx; display: flex; align-items: center; justify-content: center; }
.chip { min-height: 64rpx; display: flex; align-items: center; justify-content: center; }
.band { min-height: 56rpx; display: flex; align-items: center; justify-content: center; }
.tour-btn { min-height: 80rpx; display: flex; align-items: center; justify-content: center; }

/* 考考你 */
.quiz-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 98; }
.quiz { position: fixed; left: 16rpx; right: 16rpx; z-index: 99; background: #141414; border: 1px solid #2a2a2a; border-radius: 12rpx; padding: 24rpx; max-height: 70vh; overflow-y: auto; }
.quiz-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.quiz-title { font-size: 30rpx; font-weight: 600; color: #e8e8e8; }
.quiz-close { font-size: 26rpx; color: #999; }
.quiz-progress { font-size: 22rpx; color: #777; margin-bottom: 8rpx; }
.quiz-q { font-size: 28rpx; color: #ddd; line-height: 1.5; margin-bottom: 16rpx; }
.quiz-opts { display: flex; flex-direction: column; gap: 10rpx; }
.quiz-opt { padding: 16rpx 20rpx; border: 1px solid #333; border-radius: 8rpx; font-size: 26rpx; color: #bbb; }
.quiz-opt.right { border-color: #4a4; color: #6c6; background: rgba(68,170,68,.08); }
.quiz-opt.wrong { border-color: #a44; color: #c66; background: rgba(170,68,68,.08); }
.quiz-why { margin-top: 14rpx; padding: 14rpx; background: rgba(255,255,255,.04); border-radius: 6rpx; font-size: 24rpx; color: #99a; line-height: 1.6; }
.quiz-next { margin-top: 16rpx; text-align: center; padding: 16rpx; border: 1px solid #556; border-radius: 8rpx; font-size: 28rpx; color: #ccd; }
.quiz-done { font-size: 26rpx; color: #aab; line-height: 1.7; margin-bottom: 16rpx; }
.quiz-restart { text-align: center; padding: 14rpx; border: 1px solid #456; border-radius: 8rpx; font-size: 26rpx; color: #bcd; }

