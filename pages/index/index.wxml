<view class="stage">
  <canvas
    id="gl"
    type="2d"
    class="gl"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
  ></canvas>

  <!-- 抬头。四个顶层的 top 都由 index.js 的 measureTop() 量出来，
       写死 rpx 会顶在状态栏和右上角胶囊按钮上 -->
  <view class="title" style="top:{{topTitle}}px">
    <view class="title-main">赵州桥</view>
    <view class="title-sub">隋 · 大业年间 595—605 · 匠人李春</view>
  </view>
  <view class="topbtns" style="top:{{topBtn}}px">
    <view class="src-btn" hover-class="pressed" aria-role="button" bindtap="onTourOpen">导览</view>
    <view class="src-btn" hover-class="pressed" aria-role="button" bindtap="onToggleSec">剖面图</view>
    <view class="src-btn" hover-class="pressed" aria-role="button" bindtap="onToggleSrc">数据出处</view>
    <view class="src-btn" hover-class="pressed" aria-role="button" bindtap="onQuizOpen">考考你</view>  </view>

  <!-- 营造阶段卡。剖面图铺开时这三张卡一概让位，不然和剖面挤在一起 -->
  <view class="phase" wx:if="{{mode === 'build' && !sec && !focus}}" style="top:{{topCard}}px">
    <view class="phase-name">{{phaseName}}</view>
    <view class="phase-desc">{{phaseDesc}}</view>
    <view class="bar"><view class="bar-fill" style="width:{{progressPct}}%"></view></view>
    <view class="phase-foot">
      <text>已砌 {{builtCount}} / 28 道拱券</text>
      <text>{{progressPct}}%</text>
    </view>
  </view>

  <!-- 泄洪读数 -->
  <view class="hud" wx:if="{{mode === 'flood' && !sec && !focus}}" style="top:{{topCard}}px">
    <view class="hud-row">
      <view class="cell">
        <view class="cell-v">{{readout.h}}</view>
        <view class="cell-k">水位 m（起拱线上）</view>
      </view>
      <view class="cell">
        <view class="cell-v">{{readout.area}}</view>
        <view class="cell-k">过水面积 m²</view>
      </view>
      <view class="cell">
        <view class="cell-v">{{readout.v}}</view>
        <view class="cell-k">流速 m/s</view>
      </view>
    </view>
    <view class="hud-row">
      <view class="cell">
        <view class="cell-v">{{readout.force}}</view>
        <view class="cell-k">冲击力 kN</view>
      </view>
      <view class="cell">
        <view class="cell-v">{{readout.backwater}}</view>
        <view class="cell-k">上游壅水 m</view>
      </view>
      <view class="cell">
        <view class="cell-v">{{readout.pMax}}</view>
        <view class="cell-k">河床压强 kPa</view>
      </view>
    </view>
  </view>

  <!-- 部位聚焦卡。轻点桥身落在锚点 40 px 内就飞到特写机位并弹出；
       打开时盖掉同位置的读数/阶段卡，关掉即回——两张卡不该同屏叠字 -->
  <view class="focus" wx:if="{{focus}}" style="top:{{topCard}}px">
    <view class="focus-head">
      <text class="focus-name">{{focus.name}}</text>
      <text class="focus-close" aria-role="button" bindtap="onFocusClose">收起</text>
    </view>
    <view class="focus-l1">{{focus.l1}}</view>
    <view class="focus-l2">{{focus.l2}}</view>
  </view>

  <!-- 敞肩 / 实肩 对比。左栏是此刻的水力对比，右栏是四个小拱静态的
       省料账，最后一行横跨两栏。八行竖排要 190 px 高，会压到桥面上——
       竖屏上半只有 300 px 可用（桥顶在 390 px 上下），分两栏才收得进 -->
  <view class="cmp" wx:if="{{mode === 'flood' && open && !sec && !focus}}" style="top:{{topCmp}}px">
    <view class="cmp-row">
      <view class="cmp-col">
        <view class="cmp-title">敞肩之利（相对实肩拱）</view>
        <view class="cmp-line">过水面积增大约 <text class="hl">{{diff.areaPct}}%</text></view>
        <view class="cmp-line">水流冲击力降低 <text class="hl">{{diff.forcePct}}%</text></view>
        <view class="cmp-line">上游壅水降低 <text class="hl">{{diff.hDown}} m</text></view>
      </view>
      <view class="cmp-col">
        <view class="cmp-title">四小拱凿掉的石方</view>
        <view class="cmp-line">全孔断面 <text class="hl">{{sp.voidArea}} m²</text></view>
        <view class="cmp-line">占拱肩 <text class="hl">{{sp.share}}%</text></view>
        <view class="cmp-line">少砌石 <text class="hl">{{sp.voidVol}} m³</text>（{{sp.stone}} 吨）</view>
      </view>
    </view>
    <view class="cmp-line cmp-wide">此刻过水的小拱 <text class="hl">{{sp.flowing}}</text>，多走出水 <text class="hl">{{sp.nowArea}} m²</text></view>
  </view>

  <!-- 底部控制台 -->
  <view class="panel">
    <view class="tabs">
      <view class="tab {{mode === 'build' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-mode="build" bindtap="onTab">营 造</view>
      <view class="tab {{mode === 'flood' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-mode="flood" bindtap="onTab">泄 洪</view>
    </view>

    <block wx:if="{{mode === 'build'}}">
      <view class="ctrl">
        <view class="btn" hover-class="pressed" aria-role="button" bindtap="onTogglePlay">{{playing ? '暂停' : '播放'}}</view>
        <view class="btn ghost" hover-class="pressed" aria-role="button" bindtap="onRestart">重砌</view>
        <slider
          class="grow" min="0" max="1000" value="{{progressPct * 10}}"
          block-size="14" activeColor="#c4563a" backgroundColor="#d8cfbd"
          bindchange="onSeek" bindchanging="onSeek"
        />
      </view>
      <view class="ctrl">
        <text class="lab">速度</text>
        <slider
          class="grow" min="0" max="3" value="1" show-value
          block-size="14" activeColor="#c4563a" backgroundColor="#d8cfbd"
          bindchange="onSpeed"
        />
      </view>
      <view class="views">
        <view class="chip {{view === 'full' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-v="full" bindtap="onView">全景</view>
        <view class="chip {{view === 'under' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-v="under" bindtap="onView">拱下</view>
        <view class="chip {{view === 'small' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-v="small" bindtap="onView">小拱</view>
        <view class="chip {{flat ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleFlat">坦拱对照</view>
        <view class="chip {{split ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleSplit">
          {{split ? '装回 28 券' : '拆解 28 券'}}
        </view>
        <view class="chip {{anno ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleAnno">标注</view>
      </view>
    </block>

    <block wx:else>
      <view class="ctrl">
        <text class="lab">水量</text>
        <slider
          class="grow" min="150" max="1300" value="{{q}}"
          block-size="14" activeColor="#3a6f9e" backgroundColor="#d8cfbd"
          bindchange="onQ" bindchanging="onQ"
        />
        <text class="val">{{q}} m³/s</text>
      </view>
      <!-- 水量尺。三段的宽度按流量区间等比给，交界处正好就是两个临界流量。
           已经漫过的档整段点亮，读法是"水已经漫到这几孔了" -->
      <view class="bands">
        <view
          class="band {{index <= band ? 'on' : ''}}"
          wx:for="{{bands}}" wx:key="label"
          style="flex:{{item.w}}"
          hover-class="pressed" aria-role="button"
          data-q="{{item.q}}" bindtap="onBand"
        >{{item.label}}</view>
      </view>
      <view class="views">
        <view class="chip {{view === 'full' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-v="full" bindtap="onView">全景</view>
        <view class="chip {{view === 'small' ? 'on' : ''}}" hover-class="pressed" aria-role="button" data-v="small" bindtap="onView">小拱</view>
        <view class="chip {{anno ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleAnno">标注</view>
        <view class="chip {{open ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleSpandrel">
          {{open ? '敞肩拱' : '实肩拱'}}
        </view>
        <view class="chip {{thrust ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleThrust">受力</view>
        <view class="chip {{autoFlood ? 'on' : ''}}" hover-class="pressed" aria-role="button" bindtap="onToggleAuto">洪水过程</view>
      </view>
      <view class="hint">
        拖动旋转，双指缩放。外侧两个小拱在 {{qOuter}} m³/s 开始过水，内侧两个要
        涨到 {{qInner}} m³/s——尺子上点一段可直接跳到那一档。
        切「实肩拱」看没有小拱时的过水，开「受力」看重量怎么沿拱轴压到两岸。
        轻点拱、券、桥台等部位可聚焦细看。
      </view>
    </block>
  </view>

  <!-- 说课导览。盖在控制台之上：导览进行中只留上一步/下一步，其余控件先收起，
       避免和底部按钮抢屏幕。写在 panel 之后，同级绝对定位按书写次序叠放 -->
  <view class="tour" wx:if="{{tour !== null}}">
    <view class="tour-head">
      <view class="tour-step">{{tourIdx + 1}} / {{tourTotal}}</view>
      <view class="tour-name">{{tourName}}</view>
      <view class="tour-exit" hover-class="pressed" aria-role="button" bindtap="onTourExit">退出</view>
    </view>
    <view class="tour-text">{{tourText}}</view>
    <view class="tour-btns">
      <view class="tour-btn prev {{tourIdx === 0 ? 'off' : ''}}" hover-class="pressed" aria-role="button" bindtap="onTourPrev">上一步</view>
      <view class="tour-btn main" hover-class="pressed" aria-role="button" bindtap="onTourNext">{{tourIdx + 1 === tourTotal ? '完成' : '下一步'}}</view>
    </view>
  </view>

  <!-- 考考你 -->
  <view class="quiz-mask" wx:if="{{quizOpen}}" bindtap="onQuizClose"></view>
  <view class="quiz" wx:if="{{quizOpen}}" style="top:{{topTitle}}px">
    <view class="quiz-head">
      <text class="quiz-title">考考你</text>
      <text class="quiz-close" aria-role="button" bindtap="onQuizClose">关闭</text>
    </view>
    <block wx:if="{{!quizDone}}">
      <view class="quiz-progress">{{quizIdx + 1}} / 3</view>
      <view class="quiz-q">{{QUIZ[quizIdx].q}}</view>
      <view class="quiz-opts">
        <view
          class="quiz-opt {{quizPick === i ? (i === QUIZ[quizIdx].a ? 'right' : 'wrong') : ''}}"
          wx:for="{{QUIZ[quizIdx].opts}}" wx:for-item="opt" wx:for-index="i" wx:key="*this"
          hover-class="pressed" aria-role="button"
          data-i="{{i}}" bindtap="onQuizPick"
        >{{opt}}</view>
      </view>
      <view class="quiz-why" wx:if="{{quizPick !== null}}">{{QUIZ[quizIdx].why}}</view>
      <view class="quiz-next" wx:if="{{quizPick !== null}}" hover-class="pressed" bindtap="onQuizNext">{{quizIdx + 1 < 3 ? '下一题' : '完成'}}</view>
    </block>
    <block wx:else>
      <view class="quiz-done">三题完成！回到场景里再看看：拱肩的小拱为什么比拱顶的开口大，洪水先从哪孔漫过，水平推力往哪里走。</view>
      <view class="quiz-restart" hover-class="pressed" bindtap="onQuizRestart">再来一次</view>
    </block>
  </view>

  <!-- 史料出处。必须放在最后：这一层要盖住上面的读数卡和控制台，
       而同级绝对定位元素的叠放次序就是书写次序，写在前面就会被盖住 -->
  <view class="src-mask" wx:if="{{srcOpen}}" bindtap="onToggleSrc"></view>
  <view class="src" wx:if="{{srcOpen}}" style="top:{{topTitle}}px">
    <view class="src-head">
      <text class="src-title">尺寸、做法与出处</text>
      <text class="src-close" aria-role="button" bindtap="onToggleSrc">关闭</text>
    </view>
    <view class="src-tabs">
      <view
        class="src-tab {{srcTab === t ? 'on' : ''}}"
        wx:for="{{srcTabs}}" wx:for-item="t" wx:key="*this"
        hover-class="pressed" aria-role="button"
        data-t="{{t}}" bindtap="onSrcTab"
      >{{t}}</view>
    </view>
    <scroll-view class="src-body" scroll-y>
      <block wx:for="{{sources}}" wx:key="g">
        <block wx:if="{{item.tab === srcTab}}">
          <view class="src-group">{{item.g}}</view>
          <view class="src-row" wx:for="{{item.rows}}" wx:for-item="r" wx:key="n">
            <text class="src-k">{{r.n}}</text>
            <text class="src-v">{{r.v}}</text>
          </view>
          <view class="src-src">{{item.from}}</view>
        </block>
      </block>
      <block wx:if="{{srcTab === '年表'}}">
        <view class="an-row" wx:for="{{annals}}" wx:key="t">
          <text class="an-y">{{item.y}}</text>
          <view class="an-body">
            <text class="an-t">{{item.t}}</text>
            <text class="an-s">{{item.s}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
